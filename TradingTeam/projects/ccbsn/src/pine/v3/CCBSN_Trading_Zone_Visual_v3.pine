//@version=6
indicator("CCBSN Bot 2 - M15 Dual Policy Visual v3.1.3", "CCBSN TZ v3.1.3", overlay = true,
     max_boxes_count = 500, max_labels_count = 500)

// Visual-only TradingView policy prototype for CCBSN Bot 2 Ver3.
// It never places orders and never controls the MT5 CCBSN EA.
// Policy family is frozen when POLICY ALLOW starts:
//   D >= 0 at activation -> UpsidePolicy
//   D <  0 at activation -> DownsidePolicy

