int emaHistoryBars = input.int(400, "EMA history bars", minval = 1,
     maxval = 5000, group = GROUP_DISPLAY)
color emaColor = input.color(color.rgb(205, 90, 45), "EMA color", group = GROUP_DISPLAY)
