int atrPeriod = input.int(20, "ATR period", minval = 1, group = GROUP_COMMON)
float minAtrPrice = input.float(3.0, "Minimum ATR (raw price)", minval = 0.000001,
     step = 0.1, group = GROUP_COMMON)
int emaPeriod = input.int(23, "EMA period", minval = 1, group = GROUP_COMMON)
bool enableActiveLowAtrBlock = input.bool(true, "OFF after low-ATR sequence",
     group = GROUP_COMMON)
float activeLowAtrThreshold = input.float(7.0, "Low ATR threshold (strictly below)",
     minval = 0.000001, step = 0.1, group = GROUP_COMMON)
int activeLowAtrBars = input.int(3, "Consecutive low-ATR bars while ACTIVE",
     minval = 1, maxval = 20, group = GROUP_COMMON)

