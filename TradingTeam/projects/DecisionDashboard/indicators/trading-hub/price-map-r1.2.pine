//@version=6
indicator("DD · SMC Price Map + Elliott [R1.2]", "DD SMC Elliott R1.2", overlay = true, max_bars_back = 5000, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// Research price-map profile. Trading Hub concepts define the event order; internal pivots,
// Decision POI selection and important-FVG ranking remain explicit implementation
// seams until reviewed bar-by-bar by a domain expert. Elliott is a separate profile layer:
// it consumes confirmed SMC H/L and the lifecycle of their outgoing important FVGs.

string GROUP_ENGINE = "01 · Structure engine"
string GROUP_ZONES = "02 · Zone rules"
string GROUP_DISPLAY = "03 · Display"
string GROUP_SYMBOLS = "04 · Sweep symbols"
string GROUP_CORE = "05 · Core swings"
string GROUP_ELLIOTT = "06 · Elliott overlay"

int internalBars = input.int(1, "Internal pivot bars (left/right)", minval = 1, maxval = 10, group = GROUP_ENGINE, tooltip = "Research seam used to surface a possible internal pullback; not every fractal is claimed to be canonical Trading Hub IDM.")
string confirmationMode = input.string("Any take", "IDM confirmation", options = ["Any take", "Sweep / re-entry", "Close / break"], group = GROUP_ENGINE, tooltip = "Any take confirms on the first penetration and classifies it as sweep or break. Strict modes accept only the selected event type.")
string bootstrapMode = input.string("Auto", "First leg", options = ["Auto", "Confirm high first", "Confirm low first"], group = GROUP_ENGINE)

int zoneLookback = input.int(40, "Zone search bars", minval = 3, maxval = 200, group = GROUP_ZONES)
int maxZones = input.int(24, "Zones retained", minval = 4, maxval = 80, group = GROUP_ZONES)
string poiRange = input.string("Full candle", "POI range", options = ["Full candle", "Body"], group = GROUP_ZONES)
string poiInvalidation = input.string("Close beyond", "POI invalidation", options = ["Close beyond", "Wick beyond"], group = GROUP_ZONES)
int zoneStartPaddingBars = input.int(1, "POI/FVG start padding (bars)", minval = 0, maxval = 10, group = GROUP_ZONES, tooltip = "Starts the projected zone after its source candle, or after the third FVG candle, so the box does not cover the pattern that created it.")

bool showSweeps = input.bool(true, "Show sweep symbols and origin lines", group = GROUP_DISPLAY)
bool showIdmEvents = input.bool(true, "Show IDM sweep/break events", group = GROUP_DISPLAY)
bool showImbalance = input.bool(true, "Show important imbalance", group = GROUP_DISPLAY)
bool showDecisionPoi = input.bool(true, "Show Decision POI", group = GROUP_DISPLAY)
bool showExtremePoi = input.bool(true, "Show effective Extreme POI", group = GROUP_DISPLAY)
bool showStatus = input.bool(false, "Show diagnostics status", group = GROUP_DISPLAY)

float coreMinReversalAtr = input.float(1.0, "Minimum SMC reversal (ATR)", minval = 0.0, maxval = 10.0, step = 0.1, group = GROUP_CORE, tooltip = "Filters the confirmed Trading Hub H/L stream; it does not create an independent fractal pivot.")
float coreMinReversalPercent = input.float(0.0, "Minimum SMC reversal (%)", minval = 0.0, maxval = 20.0, step = 0.1, group = GROUP_CORE)
bool showCoreSwings = input.bool(false, "Show extra core H/L", group = GROUP_CORE, tooltip = "Off by default because the SMC H/L layer already marks the same structural stream.")
bool showCorePath = input.bool(false, "Connect core pivots", group = GROUP_CORE)
int corePivotsRetained = input.int(40, "Core pivots retained", minval = 12, maxval = 80, group = GROUP_CORE)

bool showElliott = input.bool(true, "Show validated Elliott impulse", group = GROUP_ELLIOTT)
string elliottImbalanceRule = input.string("Latest motive IMB", "SMC imbalance support", options = ["Latest motive IMB", "At least 2 motive IMBs", "All 3 motive IMBs"], group = GROUP_ELLIOTT, tooltip = "Every mode requires the latest motive-leg IMP-FVG to remain unfilled. Stricter modes also require earlier motive imbalances to remain valid.")

string liquiditySweepSymbol = input.string("Triangle", "Liquidity sweep", options = ["Triangle", "Diamond", "Circle", "Square", "Cross"], group = GROUP_SYMBOLS)
string idmSweepSymbol = input.string("Diamond", "IDM sweep", options = ["Triangle", "Diamond", "Circle", "Square", "Cross"], group = GROUP_SYMBOLS)
string idmBreakSymbol = input.string("Square", "IDM break", options = ["Triangle", "Diamond", "Circle", "Square", "Cross"], group = GROUP_SYMBOLS)
float eventSymbolPaddingAtr = input.float(0.18, "Sweep symbol padding (ATR)", minval = 0.05, maxval = 3.0, step = 0.05, group = GROUP_SYMBOLS)
int eventSymbolsRetained = input.int(120, "Sweep symbols retained", minval = 20, maxval = 300, group = GROUP_SYMBOLS)

color highColor = color.rgb(255, 101, 92)
color lowColor = color.rgb(66, 211, 146)
color idmColor = color.rgb(234, 190, 84)
color idmBreakColor = color.rgb(218, 112, 96)
color sweepColor = color.rgb(240, 145, 72)
color bullImbalanceColor = color.rgb(44, 156, 118)
color bearImbalanceColor = color.rgb(180, 72, 90)
color decisionColor = color.rgb(79, 132, 219)
color extremeColor = color.rgb(164, 93, 224)
color coreColor = color.rgb(226, 226, 218)
color elliottColor = color.rgb(70, 174, 214)

f_labelStyle(string selection, bool pointsUp) =>
    switch selection
        "Diamond" => label.style_diamond
        "Circle" => label.style_circle
        "Square" => label.style_square
        "Cross" => label.style_xcross
        => pointsUp ? label.style_triangleup : label.style_triangledown

f_addEventSymbol(array<label> markers, float price, string symbolStyle, color symbolColor, int limit) =>
    label marker = label.new(x = bar_index, y = price, text = "", xloc = xloc.bar_index, yloc = yloc.price, style = symbolStyle, color = color.new(symbolColor, 8), textcolor = color.new(symbolColor, 100), size = size.tiny)
    array.push(markers, marker)
    if array.size(markers) > limit
        label.delete(array.shift(markers))

f_registerCorePivot(array<float> prices, array<int> bars, array<int> directions, array<int> supportImbalanceIds, array<label> pivotLabels, array<line> pivotLines, float pivotPrice, int pivotBar, int direction, int outgoingImbalanceId, float reversalFloor, float labelPadding, bool drawLabels, bool drawPath, color pivotColor, int limit) =>
    int event = 0 // 0 ignored, 1 appended, 2 newest developing pivot replaced
    int count = array.size(prices)
    if count == 0
        array.push(prices, pivotPrice)
        array.push(bars, pivotBar)
        array.push(directions, direction)
        array.push(supportImbalanceIds, outgoingImbalanceId)
        label firstLabel = drawLabels ? label.new(pivotBar, pivotPrice + direction * labelPadding, direction == 1 ? "C-H" : "C-L", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, color = na, textcolor = pivotColor, size = size.tiny, tooltip = "Confirmed higher-order core pivot") : na
        array.push(pivotLabels, firstLabel)
        event := 1
    else
        int lastIndex = count - 1
        float lastPrice = array.get(prices, lastIndex)
        int lastDirection = array.get(directions, lastIndex)
        if direction == lastDirection
            bool moreExtreme = direction == 1 ? pivotPrice > lastPrice : pivotPrice < lastPrice
            if moreExtreme
                array.set(prices, lastIndex, pivotPrice)
                array.set(bars, lastIndex, pivotBar)
                array.set(supportImbalanceIds, lastIndex, outgoingImbalanceId)
                label lastLabel = array.get(pivotLabels, lastIndex)
                if not na(lastLabel)
                    label.set_xy(lastLabel, pivotBar, pivotPrice + direction * labelPadding)
                if array.size(pivotLines) > 0
                    line lastLine = array.get(pivotLines, array.size(pivotLines) - 1)
                    if not na(lastLine)
                        line.set_xy2(lastLine, pivotBar, pivotPrice)
                event := 2
        else if math.abs(pivotPrice - lastPrice) >= reversalFloor
            line nextLine = drawPath ? line.new(array.get(bars, lastIndex), lastPrice, pivotBar, pivotPrice, xloc = xloc.bar_index, color = color.new(pivotColor, 58), width = 1) : na
            label nextLabel = drawLabels ? label.new(pivotBar, pivotPrice + direction * labelPadding, direction == 1 ? "C-H" : "C-L", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, color = na, textcolor = pivotColor, size = size.tiny, tooltip = "Confirmed higher-order core pivot") : na
            array.push(prices, pivotPrice)
            array.push(bars, pivotBar)
            array.push(directions, direction)
            array.push(supportImbalanceIds, outgoingImbalanceId)
            array.push(pivotLabels, nextLabel)
            array.push(pivotLines, nextLine)
            event := 1

    if array.size(prices) > limit
        array.shift(prices)
        array.shift(bars)
        array.shift(directions)
        array.shift(supportImbalanceIds)
        label expiredLabel = array.shift(pivotLabels)
        if not na(expiredLabel)
            label.delete(expiredLabel)
        if array.size(pivotLines) > 0
            line expiredLine = array.shift(pivotLines)
            if not na(expiredLine)
                line.delete(expiredLine)
    event

f_impulseDirection(array<float> prices, array<int> directions, int start) =>
    float p0 = array.get(prices, start)
    float p1 = array.get(prices, start + 1)
    float p2 = array.get(prices, start + 2)
    float p3 = array.get(prices, start + 3)
    float p4 = array.get(prices, start + 4)
    float p5 = array.get(prices, start + 5)
    bool bullDirections = array.get(directions, start) == -1 and array.get(directions, start + 1) == 1 and array.get(directions, start + 2) == -1 and array.get(directions, start + 3) == 1 and array.get(directions, start + 4) == -1 and array.get(directions, start + 5) == 1
    bool bearDirections = array.get(directions, start) == 1 and array.get(directions, start + 1) == -1 and array.get(directions, start + 2) == 1 and array.get(directions, start + 3) == -1 and array.get(directions, start + 4) == 1 and array.get(directions, start + 5) == -1
    float wave1 = math.abs(p1 - p0)
    float wave3 = math.abs(p3 - p2)
    float wave5 = math.abs(p5 - p4)
    bool wave3NotShortest = wave3 >= math.min(wave1, wave5)
    bool bullRules = bullDirections and p2 > p0 and p3 > p1 and p4 > p1 and p5 > p3 and wave3NotShortest
    bool bearRules = bearDirections and p2 < p0 and p3 < p1 and p4 < p1 and p5 < p3 and wave3NotShortest
    bullRules ? 1 : bearRules ? -1 : 0

f_partialImpulseDirection(array<float> prices, array<int> directions, int start, int finish) =>
    int lastOffset = finish - start
    int originDirection = array.get(directions, start)
    int impulseDirection = originDirection == -1 ? 1 : originDirection == 1 ? -1 : 0
    bool directionsMatch = impulseDirection != 0
    for offset = 0 to lastOffset
        int expectedDirection = impulseDirection == 1 ? (offset % 2 == 0 ? -1 : 1) : (offset % 2 == 0 ? 1 : -1)
        if array.get(directions, start + offset) != expectedDirection
            directionsMatch := false

    float p0 = array.get(prices, start)
    float p1 = array.get(prices, start + 1)
    bool rulesPass = directionsMatch
    if lastOffset >= 2
        float p2 = array.get(prices, start + 2)
        rulesPass := rulesPass and (impulseDirection == 1 ? p2 > p0 : p2 < p0)
    if lastOffset >= 3
        float p3 = array.get(prices, start + 3)
        rulesPass := rulesPass and (impulseDirection == 1 ? p3 > p1 : p3 < p1)
    if lastOffset >= 4
        float p4 = array.get(prices, start + 4)
        rulesPass := rulesPass and (impulseDirection == 1 ? p4 > p1 : p4 < p1)
    if lastOffset >= 5
        rulesPass := rulesPass and f_impulseDirection(prices, directions, start) == impulseDirection
    rulesPass ? impulseDirection : 0

f_partialSupportId(array<int> supportImbalanceIds, int start, int finish) =>
    int lastOffset = finish - start
    int motiveOffset = lastOffset >= 5 ? 4 : lastOffset >= 3 ? 2 : 0
    array.get(supportImbalanceIds, start + motiveOffset)

f_clearElliott(array<label> waveLabels, array<line> waveLines) =>
    if array.size(waveLabels) > 0
        for index = 0 to array.size(waveLabels) - 1
            label.delete(array.get(waveLabels, index))
        array.clear(waveLabels)
    if array.size(waveLines) > 0
        for index = 0 to array.size(waveLines) - 1
            line.delete(array.get(waveLines, index))
        array.clear(waveLines)

f_zoneState(array<int> zoneIds, array<int> states, int targetId) =>
    int result = 2 // Missing/pruned support fails closed as invalid.
    if not na(targetId) and array.size(zoneIds) > 0
        for index = 0 to array.size(zoneIds) - 1
            if array.get(zoneIds, index) == targetId
                result := array.get(states, index)
    result

f_validImbalanceCount(array<int> supportImbalanceIds, array<int> zoneIds, array<int> zoneStates, int start) =>
    int validCount = 0
    for motiveOffset = 0 to 4 by 2
        int supportId = array.get(supportImbalanceIds, start + motiveOffset)
        if f_zoneState(zoneIds, zoneStates, supportId) < 2
            validCount += 1
    validCount

f_impulseHasSmcSupport(array<int> supportImbalanceIds, array<int> zoneIds, array<int> zoneStates, int start, string supportRule) =>
    int latestMotiveImbalanceId = array.get(supportImbalanceIds, start + 4)
    bool latestIsValid = f_zoneState(zoneIds, zoneStates, latestMotiveImbalanceId) < 2
    int validCount = f_validImbalanceCount(supportImbalanceIds, zoneIds, zoneStates, start)
    bool rulePasses = supportRule == "Latest motive IMB" or (supportRule == "At least 2 motive IMBs" and validCount >= 2) or (supportRule == "All 3 motive IMBs" and validCount == 3)
    latestIsValid and rulePasses

f_renderElliott(array<float> prices, array<int> bars, array<int> directions, array<int> supportImbalanceIds, array<int> zoneIds, array<int> zoneStates, array<label> waveLabels, array<line> waveLines, float labelPadding, bool drawImpulse, string supportRule, color impulseColor) =>
    f_clearElliott(waveLabels, waveLines)
    int completedStart = -1
    int renderStart = -1
    int renderEnd = -1
    int count = array.size(prices)
    if drawImpulse and count >= 6
        for start = 0 to count - 6
            int direction = f_impulseDirection(prices, directions, start)
            if direction != 0 and f_impulseHasSmcSupport(supportImbalanceIds, zoneIds, zoneStates, start, supportRule)
                completedStart := start
                renderStart := start
                renderEnd := start + 5

    // Fail-visible fallback: when no complete 1-5 passes yet, show the longest
    // current SMC-pivot sequence ending at the latest core point. Question marks
    // disclose that these counts are developing, not completed Elliott waves.
    if drawImpulse and completedStart < 0 and count >= 2
        int firstStart = math.max(0, count - 6)
        for start = firstStart to count - 2
            int finish = count - 1
            int direction = f_partialImpulseDirection(prices, directions, start, finish)
            int supportId = f_partialSupportId(supportImbalanceIds, start, finish)
            if renderStart < 0 and direction != 0 and f_zoneState(zoneIds, zoneStates, supportId) < 2
                renderStart := start
                renderEnd := finish

    if renderStart >= 0
        bool completed = completedStart >= 0
        int lastWaveOffset = renderEnd - renderStart
        int validImbalances = completed ? f_validImbalanceCount(supportImbalanceIds, zoneIds, zoneStates, renderStart) : 1
        for offset = 0 to lastWaveOffset
            int index = renderStart + offset
            string waveText = offset == 0 ? "E0" : str.tostring(offset) + (completed ? "" : "?")
            float labelPrice = array.get(prices, index) + array.get(directions, index) * labelPadding
            string impulseTooltip = (completed ? "Validated" : "Developing") + " SMC-supported Elliott " + (offset == 0 ? "origin" : "wave " + str.tostring(offset)) + " · valid motive IMB " + str.tostring(validImbalances) + (completed ? "/3" : " current")
            label waveLabel = label.new(array.get(bars, index), labelPrice, waveText, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, color = na, textcolor = color.new(impulseColor, completed ? 0 : 24), size = size.small, tooltip = impulseTooltip)
            array.push(waveLabels, waveLabel)
            if offset > 0
                bool motiveLeg = offset % 2 == 1
                int legTransparency = completed ? (motiveLeg ? 10 : 58) : (motiveLeg ? 36 : 72)
                line waveLine = line.new(array.get(bars, index - 1), array.get(prices, index - 1), array.get(bars, index), array.get(prices, index), xloc = xloc.bar_index, color = color.new(impulseColor, legTransparency), style = motiveLeg ? line.style_solid : line.style_dotted, width = motiveLeg ? 2 : 1)
                array.push(waveLines, waveLine)
    int activeSupportId = renderStart >= 0 ? f_partialSupportId(supportImbalanceIds, renderStart, renderEnd) : na
    [completedStart, activeSupportId]

f_addZone(array<box> boxes, array<string> kinds, array<int> directions, array<int> states, array<color> colors, array<bool> visibility, array<int> ids, int leftBar, float zoneTop, float zoneBottom, int direction, string kind, color zoneColor, bool visible, int zoneId, int limit) =>
    int initialRight = math.max(bar_index, leftBar)
    box created = box.new(left = leftBar, top = zoneTop, right = initialRight, bottom = zoneBottom, xloc = xloc.bar_index, extend = extend.right, border_color = color.new(zoneColor, visible ? 48 : 100), bgcolor = color.new(zoneColor, visible ? 90 : 100), text = visible ? kind : "", text_color = color.new(zoneColor, visible ? 8 : 100), text_size = size.tiny, text_halign = text.align_left)
    array.push(boxes, created)
    array.push(kinds, kind)
    array.push(directions, direction)
    array.push(states, 0)
    array.push(colors, zoneColor)
    array.push(visibility, visible)
    array.push(ids, zoneId)
    if array.size(boxes) > limit
        box.delete(array.shift(boxes))
        array.shift(kinds)
        array.shift(directions)
        array.shift(states)
        array.shift(colors)
        array.shift(visibility)
        array.shift(ids)
    created

f_updateZones(array<box> boxes, array<string> kinds, array<int> directions, array<int> states, array<color> colors, array<bool> visibility, string invalidationMode) =>
    if array.size(boxes) > 0
        for index = 0 to array.size(boxes) - 1
            int state = array.get(states, index)
            box zone = array.get(boxes, index)
            if state < 2 and bar_index >= box.get_left(zone)
                string kind = array.get(kinds, index)
                int direction = array.get(directions, index)
                color zoneColor = array.get(colors, index)
                bool visible = array.get(visibility, index)
                float zoneTop = box.get_top(zone)
                float zoneBottom = box.get_bottom(zone)
                bool touched = direction == 1 ? low <= zoneTop : high >= zoneBottom
                bool finished = kind == "IMP-FVG" ? (direction == 1 ? low <= zoneBottom : high >= zoneTop) : (direction == 1 ? (invalidationMode == "Close beyond" ? close < zoneBottom : low < zoneBottom) : (invalidationMode == "Close beyond" ? close > zoneTop : high > zoneTop))
                if finished
                    array.set(states, index, 2)
                    box.set_extend(zone, extend.none)
                    box.set_right(zone, bar_index)
                    if visible
                        box.set_bgcolor(zone, color.new(zoneColor, 96))
                        box.set_border_color(zone, color.new(zoneColor, 82))
                        box.set_text(zone, kind + (kind == "IMP-FVG" ? " · ✓" : " · ×"))
                        box.set_text_color(zone, color.new(zoneColor, 58))
                else if state == 0 and touched
                    array.set(states, index, 1)
                    if visible
                        box.set_bgcolor(zone, color.new(zoneColor, 93))
                        box.set_text(zone, kind + " · T")

f_styleSupportingImbalance(array<box> boxes, array<string> kinds, array<int> states, array<color> colors, array<bool> visibility, array<int> ids, int activeSupportId) =>
    if array.size(boxes) > 0
        for index = 0 to array.size(boxes) - 1
            bool isImbalance = array.get(kinds, index) == "IMP-FVG"
            bool visible = array.get(visibility, index)
            int state = array.get(states, index)
            if isImbalance and visible and state < 2
                box zone = array.get(boxes, index)
                color zoneColor = array.get(colors, index)
                bool supportsWave = not na(activeSupportId) and array.get(ids, index) == activeSupportId
                box.set_border_width(zone, supportsWave ? 2 : 1)
                box.set_border_color(zone, color.new(zoneColor, supportsWave ? 12 : 48))
                box.set_bgcolor(zone, color.new(zoneColor, supportsWave ? 84 : state == 1 ? 93 : 90))
                box.set_text(zone, (supportsWave ? "W-IMB" : "IMP-FVG") + (state == 1 ? " · T" : ""))

float internalHigh = ta.pivothigh(high, internalBars, internalBars)
float internalLow = ta.pivotlow(low, internalBars, internalBars)
float atrBasis = nz(ta.atr(14), high - low)
float markerSpacing = math.max(atrBasis * eventSymbolPaddingAtr, syminfo.mintick * 10)

var int phase = 0 // 1 = confirm a high, -1 = confirm a low, 0 = bootstrap
var float latestInternalHigh = na
var int latestInternalHighBar = na
var float latestInternalHighOpen = na
var float latestInternalHighLow = na
var float latestInternalHighClose = na
var float latestInternalLow = na
var int latestInternalLowBar = na
var float latestInternalLowOpen = na
var float latestInternalLowHigh = na
var float latestInternalLowClose = na

var float candidateHigh = na
var int candidateHighBar = na
var float candidateHighOpen = na
var float candidateHighLow = na
var float candidateHighClose = na
var bool candidateHighSweptReference = false
var float candidateHighIdm = na
var int candidateHighIdmBar = na
var float candidateLow = na
var int candidateLowBar = na
var float candidateLowOpen = na
var float candidateLowHigh = na
var float candidateLowClose = na
var bool candidateLowSweptReference = false
var float candidateLowIdm = na
var int candidateLowIdmBar = na

var float previousConfirmedHigh = na
var int previousConfirmedHighBar = na
var float previousConfirmedLow = na
var int previousConfirmedLowBar = na
var bool previousHighConsumed = false
var bool previousLowConsumed = false
var table statusTable = table.new(position.top_right, 2, 4, border_width = 0)

var array<box> zoneBoxes = array.new<box>()
var array<string> zoneKinds = array.new<string>()
var array<int> zoneDirections = array.new<int>()
var array<int> zoneStates = array.new<int>()
var array<color> zoneColors = array.new<color>()
var array<bool> zoneVisibility = array.new<bool>()
var array<int> zoneIds = array.new<int>()
var array<label> eventSymbolLabels = array.new<label>()
var array<float> corePrices = array.new<float>()
var array<int> coreBars = array.new<int>()
var array<int> coreDirections = array.new<int>()
var array<int> coreSupportImbalanceIds = array.new<int>()
var array<label> coreLabels = array.new<label>()
var array<line> coreLines = array.new<line>()
var array<label> elliottLabels = array.new<label>()
var array<line> elliottLines = array.new<line>()
var int activeElliottImbalanceId = na
var int nextImbalanceId = 0

bool confirmedHighThisBar = false
bool confirmedLowThisBar = false
bool idmSweptThisBar = false
bool idmBrokenThisBar = false
int idmEventDirectionThisBar = 0
bool buySideSweptThisBar = false
bool sellSideSweptThisBar = false
bool importantImbalanceThisBar = false
bool decisionPoiThisBar = false
bool extremePoiThisBar = false
bool corePivotThisBar = false
bool elliottImpulseThisBar = false
bool elliottImpulseInvalidatedThisBar = false
int coreEvent = 0

if barstate.isconfirmed
    f_updateZones(zoneBoxes, zoneKinds, zoneDirections, zoneStates, zoneColors, zoneVisibility, poiInvalidation)

    // A structural-liquidity sweep must trade beyond the level and close back
    // inside. A close beyond consumes the old level as a break, not a sweep.
    if not na(previousConfirmedHigh) and not previousHighConsumed and high > previousConfirmedHigh
        previousHighConsumed := true
        if close < previousConfirmedHigh
            buySideSweptThisBar := true
            if showSweeps
                line.new(previousConfirmedHighBar, previousConfirmedHigh, bar_index, previousConfirmedHigh, xloc = xloc.bar_index, color = color.new(sweepColor, 20), style = line.style_dashed, width = 1)
    if not na(previousConfirmedLow) and not previousLowConsumed and low < previousConfirmedLow
        previousLowConsumed := true
        if close > previousConfirmedLow
            sellSideSweptThisBar := true
            if showSweeps
                line.new(previousConfirmedLowBar, previousConfirmedLow, bar_index, previousConfirmedLow, xloc = xloc.bar_index, color = color.new(sweepColor, 20), style = line.style_dashed, width = 1)

    if not na(internalHigh)
        latestInternalHigh := internalHigh
        latestInternalHighBar := bar_index - internalBars
        latestInternalHighOpen := open[internalBars]
        latestInternalHighLow := low[internalBars]
        latestInternalHighClose := close[internalBars]
    if not na(internalLow)
        latestInternalLow := internalLow
        latestInternalLowBar := bar_index - internalBars
        latestInternalLowOpen := open[internalBars]
        latestInternalLowHigh := high[internalBars]
        latestInternalLowClose := close[internalBars]

    if phase == 0
        if bootstrapMode == "Confirm high first"
            phase := 1
        else if bootstrapMode == "Confirm low first"
            phase := -1
        else if not na(latestInternalHighBar) and not na(latestInternalLowBar)
            phase := latestInternalHighBar > latestInternalLowBar ? 1 : -1

        if phase == 1 and not na(latestInternalHigh)
            candidateHigh := latestInternalHigh
            candidateHighBar := latestInternalHighBar
            candidateHighOpen := latestInternalHighOpen
            candidateHighLow := latestInternalHighLow
            candidateHighClose := latestInternalHighClose
            candidateHighSweptReference := false
            if not na(latestInternalLowBar) and latestInternalLowBar < candidateHighBar
                candidateHighIdm := latestInternalLow
                candidateHighIdmBar := latestInternalLowBar
        else if phase == -1 and not na(latestInternalLow)
            candidateLow := latestInternalLow
            candidateLowBar := latestInternalLowBar
            candidateLowOpen := latestInternalLowOpen
            candidateLowHigh := latestInternalLowHigh
            candidateLowClose := latestInternalLowClose
            candidateLowSweptReference := false
            if not na(latestInternalHighBar) and latestInternalHighBar < candidateLowBar
                candidateLowIdm := latestInternalHigh
                candidateLowIdmBar := latestInternalHighBar

    if phase == 1
        bool extendsHigh = na(candidateHigh) or high > candidateHigh
        if extendsHigh
            candidateHigh := high
            candidateHighBar := bar_index
            candidateHighOpen := open
            candidateHighLow := low
            candidateHighClose := close
            candidateHighSweptReference := buySideSweptThisBar
            if not na(latestInternalLowBar) and latestInternalLowBar < candidateHighBar
                candidateHighIdm := latestInternalLow
                candidateHighIdmBar := latestInternalLowBar

        bool hasHighSequence = not na(candidateHigh) and not na(candidateHighIdm) and candidateHighIdmBar < candidateHighBar and bar_index > candidateHighBar
        bool highIdmTaken = low < candidateHighIdm
        bool highIdmSweep = highIdmTaken and close >= candidateHighIdm
        bool highIdmBreak = close < candidateHighIdm
        bool confirmsHigh = confirmationMode == "Any take" ? highIdmTaken : confirmationMode == "Sweep / re-entry" ? highIdmSweep : highIdmBreak
        if hasHighSequence and confirmsHigh
            float oldConfirmedHigh = previousConfirmedHigh
            string highTag = na(oldConfirmedHigh) ? "H" : candidateHigh > oldConfirmedHigh ? "HH" : candidateHigh < oldConfirmedHigh ? "LH" : "EH"
            label.new(candidateHighBar, candidateHigh + markerSpacing * 0.35, highTag, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, color = na, textcolor = highColor, size = size.tiny, tooltip = "Confirmed at bar " + str.tostring(bar_index) + " after the opposing IDM event.")
            if (highIdmSweep or highIdmBreak) and showIdmEvents
                line.new(candidateHighIdmBar, candidateHighIdm, bar_index, candidateHighIdm, xloc = xloc.bar_index, color = color.new(highIdmSweep ? idmColor : idmBreakColor, 22), style = highIdmSweep ? line.style_solid : line.style_dotted, width = 1)
            idmSweptThisBar := highIdmSweep
            idmBrokenThisBar := highIdmBreak
            idmEventDirectionThisBar := -1

            // Effective bearish Extreme POI: the extreme candle swept the prior
            // confirmed high and closed back below it. No reference = no E-POI.
            bool effectiveBearExtreme = not na(oldConfirmedHigh) and candidateHighSweptReference and candidateHigh > oldConfirmedHigh and candidateHighClose < oldConfirmedHigh
            if showExtremePoi and effectiveBearExtreme
                float extremeTop = poiRange == "Full candle" ? candidateHigh : math.max(candidateHighOpen, candidateHighClose)
                float extremeBottom = poiRange == "Full candle" ? candidateHighLow : math.min(candidateHighOpen, candidateHighClose)
                f_addZone(zoneBoxes, zoneKinds, zoneDirections, zoneStates, zoneColors, zoneVisibility, zoneIds, candidateHighBar + zoneStartPaddingBars, extremeTop, extremeBottom, -1, "E-POI", extremeColor, true, 0, maxZones)
                extremePoiThisBar := true

            // Decision POI profile seam: nearest bullish candle before the
            // confirmation event, constrained to the structural leg.
            int decisionBar = na
            float decisionTop = na
            float decisionBottom = na
            if showDecisionPoi
                for i = 1 to zoneLookback
                    bool insideLeg = bar_index - i >= candidateHighBar
                    if na(decisionBar) and insideLeg and not na(close[i]) and close[i] > open[i]
                        decisionBar := bar_index - i
                        decisionTop := poiRange == "Full candle" ? high[i] : math.max(open[i], close[i])
                        decisionBottom := poiRange == "Full candle" ? low[i] : math.min(open[i], close[i])
                if not na(decisionBar)
                    f_addZone(zoneBoxes, zoneKinds, zoneDirections, zoneStates, zoneColors, zoneVisibility, zoneIds, decisionBar + zoneStartPaddingBars, decisionTop, decisionBottom, -1, "D-POI", decisionColor, true, 0, maxZones)
                    decisionPoiThisBar := true

            // Important imbalance profile seam: most recent unfilled bearish
            // three-candle FVG inside the newly confirmed leg.
            int imbalanceBar = na
            float imbalanceTop = na
            float imbalanceBottom = na
            int outgoingHighImbalanceId = na
            if showImbalance or showElliott
                for i = 0 to zoneLookback
                    bool insideLeg = bar_index - i - 2 >= candidateHighBar
                    bool bearishGap = insideLeg and not na(low[i + 2]) and high[i] < low[i + 2]
                    bool unfilled = true
                    if bearishGap
                        for j = 0 to zoneLookback
                            if j < i and high[j] >= low[i + 2]
                                unfilled := false
                    if na(imbalanceBar) and bearishGap and unfilled
                        imbalanceBar := bar_index - i - 2
                        imbalanceTop := low[i + 2]
                        imbalanceBottom := high[i]
                if not na(imbalanceBar)
                    nextImbalanceId += 1
                    outgoingHighImbalanceId := nextImbalanceId
                    f_addZone(zoneBoxes, zoneKinds, zoneDirections, zoneStates, zoneColors, zoneVisibility, zoneIds, imbalanceBar + 2 + zoneStartPaddingBars, imbalanceTop, imbalanceBottom, -1, "IMP-FVG", bearImbalanceColor, showImbalance, outgoingHighImbalanceId, maxZones)
                    importantImbalanceThisBar := true

            float coreReversalFloor = math.max(atrBasis * coreMinReversalAtr, math.abs(candidateHigh) * coreMinReversalPercent * 0.01)
            coreEvent := f_registerCorePivot(corePrices, coreBars, coreDirections, coreSupportImbalanceIds, coreLabels, coreLines, candidateHigh, candidateHighBar, 1, outgoingHighImbalanceId, coreReversalFloor, markerSpacing * 0.7, showCoreSwings, showCorePath, coreColor, corePivotsRetained)

            previousConfirmedHigh := candidateHigh
            previousConfirmedHighBar := candidateHighBar
            previousHighConsumed := false
            confirmedHighThisBar := true
            phase := -1
            candidateLow := low
            candidateLowBar := bar_index
            candidateLowOpen := open
            candidateLowHigh := high
            candidateLowClose := close
            candidateLowSweptReference := sellSideSweptThisBar
            candidateLowIdm := not na(latestInternalHighBar) and latestInternalHighBar < candidateLowBar ? latestInternalHigh : na
            candidateLowIdmBar := not na(latestInternalHighBar) and latestInternalHighBar < candidateLowBar ? latestInternalHighBar : na
            candidateHigh := na
            candidateHighBar := na
            candidateHighIdm := na
            candidateHighIdmBar := na
            candidateHighSweptReference := false

    else if phase == -1
        bool extendsLow = na(candidateLow) or low < candidateLow
        if extendsLow
            candidateLow := low
            candidateLowBar := bar_index
            candidateLowOpen := open
            candidateLowHigh := high
            candidateLowClose := close
            candidateLowSweptReference := sellSideSweptThisBar
            if not na(latestInternalHighBar) and latestInternalHighBar < candidateLowBar
                candidateLowIdm := latestInternalHigh
                candidateLowIdmBar := latestInternalHighBar

        bool hasLowSequence = not na(candidateLow) and not na(candidateLowIdm) and candidateLowIdmBar < candidateLowBar and bar_index > candidateLowBar
        bool lowIdmTaken = high > candidateLowIdm
        bool lowIdmSweep = lowIdmTaken and close <= candidateLowIdm
        bool lowIdmBreak = close > candidateLowIdm
        bool confirmsLow = confirmationMode == "Any take" ? lowIdmTaken : confirmationMode == "Sweep / re-entry" ? lowIdmSweep : lowIdmBreak
        if hasLowSequence and confirmsLow
            float oldConfirmedLow = previousConfirmedLow
            string lowTag = na(oldConfirmedLow) ? "L" : candidateLow > oldConfirmedLow ? "HL" : candidateLow < oldConfirmedLow ? "LL" : "EL"
            label.new(candidateLowBar, candidateLow - markerSpacing * 0.35, lowTag, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, color = na, textcolor = lowColor, size = size.tiny, tooltip = "Confirmed at bar " + str.tostring(bar_index) + " after the opposing IDM event.")
            if (lowIdmSweep or lowIdmBreak) and showIdmEvents
                line.new(candidateLowIdmBar, candidateLowIdm, bar_index, candidateLowIdm, xloc = xloc.bar_index, color = color.new(lowIdmSweep ? idmColor : idmBreakColor, 22), style = lowIdmSweep ? line.style_solid : line.style_dotted, width = 1)
            idmSweptThisBar := lowIdmSweep
            idmBrokenThisBar := lowIdmBreak
            idmEventDirectionThisBar := 1

            bool effectiveBullExtreme = not na(oldConfirmedLow) and candidateLowSweptReference and candidateLow < oldConfirmedLow and candidateLowClose > oldConfirmedLow
            if showExtremePoi and effectiveBullExtreme
                float extremeTop = poiRange == "Full candle" ? candidateLowHigh : math.max(candidateLowOpen, candidateLowClose)
                float extremeBottom = poiRange == "Full candle" ? candidateLow : math.min(candidateLowOpen, candidateLowClose)
                f_addZone(zoneBoxes, zoneKinds, zoneDirections, zoneStates, zoneColors, zoneVisibility, zoneIds, candidateLowBar + zoneStartPaddingBars, extremeTop, extremeBottom, 1, "E-POI", extremeColor, true, 0, maxZones)
                extremePoiThisBar := true

            int decisionBar = na
            float decisionTop = na
            float decisionBottom = na
            if showDecisionPoi
                for i = 1 to zoneLookback
                    bool insideLeg = bar_index - i >= candidateLowBar
                    if na(decisionBar) and insideLeg and not na(close[i]) and close[i] < open[i]
                        decisionBar := bar_index - i
                        decisionTop := poiRange == "Full candle" ? high[i] : math.max(open[i], close[i])
                        decisionBottom := poiRange == "Full candle" ? low[i] : math.min(open[i], close[i])
                if not na(decisionBar)
                    f_addZone(zoneBoxes, zoneKinds, zoneDirections, zoneStates, zoneColors, zoneVisibility, zoneIds, decisionBar + zoneStartPaddingBars, decisionTop, decisionBottom, 1, "D-POI", decisionColor, true, 0, maxZones)
                    decisionPoiThisBar := true

            int imbalanceBar = na
            float imbalanceTop = na
            float imbalanceBottom = na
            int outgoingLowImbalanceId = na
            if showImbalance or showElliott
                for i = 0 to zoneLookback
                    bool insideLeg = bar_index - i - 2 >= candidateLowBar
                    bool bullishGap = insideLeg and not na(high[i + 2]) and low[i] > high[i + 2]
                    bool unfilled = true
                    if bullishGap
                        for j = 0 to zoneLookback
                            if j < i and low[j] <= high[i + 2]
                                unfilled := false
                    if na(imbalanceBar) and bullishGap and unfilled
                        imbalanceBar := bar_index - i - 2
                        imbalanceTop := low[i]
                        imbalanceBottom := high[i + 2]
                if not na(imbalanceBar)
                    nextImbalanceId += 1
                    outgoingLowImbalanceId := nextImbalanceId
                    f_addZone(zoneBoxes, zoneKinds, zoneDirections, zoneStates, zoneColors, zoneVisibility, zoneIds, imbalanceBar + 2 + zoneStartPaddingBars, imbalanceTop, imbalanceBottom, 1, "IMP-FVG", bullImbalanceColor, showImbalance, outgoingLowImbalanceId, maxZones)
                    importantImbalanceThisBar := true

            float coreReversalFloor = math.max(atrBasis * coreMinReversalAtr, math.abs(candidateLow) * coreMinReversalPercent * 0.01)
            coreEvent := f_registerCorePivot(corePrices, coreBars, coreDirections, coreSupportImbalanceIds, coreLabels, coreLines, candidateLow, candidateLowBar, -1, outgoingLowImbalanceId, coreReversalFloor, markerSpacing * 0.7, showCoreSwings, showCorePath, coreColor, corePivotsRetained)

            previousConfirmedLow := candidateLow
            previousConfirmedLowBar := candidateLowBar
            previousLowConsumed := false
            confirmedLowThisBar := true
            phase := 1
            candidateHigh := high
            candidateHighBar := bar_index
            candidateHighOpen := open
            candidateHighLow := low
            candidateHighClose := close
            candidateHighSweptReference := buySideSweptThisBar
            candidateHighIdm := not na(latestInternalLowBar) and latestInternalLowBar < candidateHighBar ? latestInternalLow : na
            candidateHighIdmBar := not na(latestInternalLowBar) and latestInternalLowBar < candidateHighBar ? latestInternalLowBar : na
            candidateLow := na
            candidateLowBar := na
            candidateLowIdm := na
            candidateLowIdmBar := na
            candidateLowSweptReference := false

    // Label objects support conditional creation and dynamic label.style_* values.
    // Empty text keeps the event layer symbol-only.
    if showSweeps and buySideSweptThisBar
        f_addEventSymbol(eventSymbolLabels, high + markerSpacing, f_labelStyle(liquiditySweepSymbol, false), sweepColor, eventSymbolsRetained)
    if showSweeps and sellSideSweptThisBar
        f_addEventSymbol(eventSymbolLabels, low - markerSpacing, f_labelStyle(liquiditySweepSymbol, true), sweepColor, eventSymbolsRetained)
    if showIdmEvents and idmSweptThisBar and idmEventDirectionThisBar == -1
        f_addEventSymbol(eventSymbolLabels, low - markerSpacing * 2, f_labelStyle(idmSweepSymbol, false), idmColor, eventSymbolsRetained)
    if showIdmEvents and idmSweptThisBar and idmEventDirectionThisBar == 1
        f_addEventSymbol(eventSymbolLabels, high + markerSpacing * 2, f_labelStyle(idmSweepSymbol, true), idmColor, eventSymbolsRetained)
    if showIdmEvents and idmBrokenThisBar and idmEventDirectionThisBar == -1
        f_addEventSymbol(eventSymbolLabels, low - markerSpacing * 2, f_labelStyle(idmBreakSymbol, false), idmBreakColor, eventSymbolsRetained)
    if showIdmEvents and idmBrokenThisBar and idmEventDirectionThisBar == 1
        f_addEventSymbol(eventSymbolLabels, high + markerSpacing * 2, f_labelStyle(idmBreakSymbol, true), idmBreakColor, eventSymbolsRetained)

    // Elliott is rebuilt only when the confirmed SMC H/L stream changes or
    // when its latest motive IMP-FVG becomes filled/pruned. This keeps the
    // active wave tied to SMC structure and imbalance lifecycle.
    bool activeSupportInvalidated = not na(activeElliottImbalanceId) and f_zoneState(zoneIds, zoneStates, activeElliottImbalanceId) >= 2
    if coreEvent > 0 or activeSupportInvalidated
        corePivotThisBar := coreEvent == 1
        elliottImpulseInvalidatedThisBar := activeSupportInvalidated
        [latestImpulseStart, refreshedSupportId] = f_renderElliott(corePrices, coreBars, coreDirections, coreSupportImbalanceIds, zoneIds, zoneStates, elliottLabels, elliottLines, markerSpacing * 1.25, showElliott, elliottImbalanceRule, elliottColor)
        activeElliottImbalanceId := refreshedSupportId
        elliottImpulseThisBar := coreEvent == 1 and latestImpulseStart >= 0 and latestImpulseStart + 5 == array.size(corePrices) - 1

    f_styleSupportingImbalance(zoneBoxes, zoneKinds, zoneStates, zoneColors, zoneVisibility, zoneIds, activeElliottImbalanceId)

if barstate.islast
    if showStatus
        table.cell(statusTable, 0, 0, "SMC R1.2", text_color = color.new(color.white, 12), bgcolor = color.new(color.rgb(26, 31, 36), 12), text_size = size.tiny)
        table.cell(statusTable, 1, 0, "LOADED", text_color = lowColor, bgcolor = color.new(color.rgb(26, 31, 36), 12), text_size = size.tiny)
        table.cell(statusTable, 0, 1, "SEEK", text_color = color.new(color.silver, 25), text_size = size.tiny)
        table.cell(statusTable, 1, 1, phase == 1 ? "H" : phase == -1 ? "L" : "…", text_color = phase == 1 ? highColor : lowColor, text_size = size.tiny)
        table.cell(statusTable, 0, 2, "IDM", text_color = color.new(color.silver, 25), text_size = size.tiny)
        table.cell(statusTable, 1, 2, phase == 1 and not na(candidateHighIdm) or phase == -1 and not na(candidateLowIdm) ? "●" : "○", text_color = idmColor, text_size = size.tiny)
        table.cell(statusTable, 0, 3, "ZONE", text_color = color.new(color.silver, 25), text_size = size.tiny)
        table.cell(statusTable, 1, 3, str.tostring(array.size(zoneBoxes)), text_color = color.new(color.white, 12), text_size = size.tiny)
    else
        table.clear(statusTable, 0, 0, 1, 3)

alertcondition(confirmedHighThisBar, "Trading Hub high confirmed", "A structure high was confirmed after its IDM event on {{ticker}} {{interval}}.")
alertcondition(confirmedLowThisBar, "Trading Hub low confirmed", "A structure low was confirmed after its IDM event on {{ticker}} {{interval}}.")
alertcondition(idmSweptThisBar, "IDM swept", "An active IDM was swept and price closed back across it on {{ticker}} {{interval}}.")
alertcondition(idmBrokenThisBar, "IDM broken", "An active IDM was broken by a confirmed close on {{ticker}} {{interval}}.")
alertcondition(buySideSweptThisBar, "Buy-side liquidity swept", "A confirmed structure high was swept with re-entry on {{ticker}} {{interval}}.")
alertcondition(sellSideSweptThisBar, "Sell-side liquidity swept", "A confirmed structure low was swept with re-entry on {{ticker}} {{interval}}.")
alertcondition(importantImbalanceThisBar, "Important imbalance created", "A profile-selected important imbalance was created on {{ticker}} {{interval}}.")
alertcondition(decisionPoiThisBar, "Decision POI created", "A profile-selected Decision POI was created on {{ticker}} {{interval}}.")
alertcondition(extremePoiThisBar, "Effective Extreme POI created", "An Extreme POI passed the sweep-and-re-entry validity gate on {{ticker}} {{interval}}.")
alertcondition(corePivotThisBar, "Core pivot confirmed", "A higher-order core pivot was confirmed on {{ticker}} {{interval}}.")
alertcondition(elliottImpulseThisBar, "SMC-supported Elliott impulse validated", "A strict 1-2-3-4-5 Elliott impulse with valid motive imbalance support was validated on {{ticker}} {{interval}}.")
alertcondition(elliottImpulseInvalidatedThisBar, "Elliott impulse IMB invalidated", "The latest motive imbalance supporting the active Elliott impulse was filled or pruned on {{ticker}} {{interval}}.")
