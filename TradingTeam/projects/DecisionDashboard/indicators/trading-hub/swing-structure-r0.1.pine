//@version=6
indicator("DD · Trading Hub Swing Structure [R0.1]", "DD TH Swing R0.1", overlay = true, max_labels_count = 500, max_lines_count = 500)

// Research implementation of Trading Hub's mechanical structure sequence:
// an extreme is structural only after the opposing internal pullback (IDM)
// is swept/broken. Internal-pivot geometry is an explicit implementation input,
// not a claim that every fractal is a canonical Trading Hub IDM.

string GROUP_ENGINE = "01 · Trading Hub structure engine"
string GROUP_DISPLAY = "02 · Display"

int internalBars = input.int(1, "Internal pivot bars (left/right)", minval = 1, maxval = 10, group = GROUP_ENGINE, tooltip = "Implementation seam used to surface a possible internal pullback. Validate this setting against reviewed Trading Hub examples for each market/timeframe.")
string breakMode = input.string("Wick / sweep", "IDM validation", options = ["Wick / sweep", "Close / break"], group = GROUP_ENGINE, tooltip = "Wick mode validates when price trades through IDM. Close mode waits for a confirmed close through IDM.")
string bootstrapMode = input.string("Auto", "First leg", options = ["Auto", "Confirm high first", "Confirm low first"], group = GROUP_ENGINE)

bool showIdm = input.bool(true, "Show IDM used for confirmation", group = GROUP_DISPLAY)
bool showConfirmation = input.bool(true, "Show confirmation bar", group = GROUP_DISPLAY, tooltip = "The H/L label is backfilled on the extreme only when this later confirmation bar closes.")
bool showCandidate = input.bool(false, "Show current unconfirmed candidate", group = GROUP_DISPLAY)
bool showStatus = input.bool(true, "Show engine status", group = GROUP_DISPLAY)

color highColor = color.rgb(255, 101, 92)
color lowColor = color.rgb(66, 211, 146)
color idmColor = color.rgb(234, 190, 84)
color candidateColor = color.new(color.silver, 45)

float internalHigh = ta.pivothigh(high, internalBars, internalBars)
float internalLow = ta.pivotlow(low, internalBars, internalBars)

var int phase = 0 // 1 = confirm a high, -1 = confirm a low, 0 = wait for bootstrap
var float latestInternalHigh = na
var int latestInternalHighBar = na
var float latestInternalLow = na
var int latestInternalLowBar = na

var float candidateHigh = na
var int candidateHighBar = na
var float candidateHighIdm = na
var int candidateHighIdmBar = na
var float candidateLow = na
var int candidateLowBar = na
var float candidateLowIdm = na
var int candidateLowIdmBar = na

var float previousConfirmedHigh = na
var float previousConfirmedLow = na
var label liveCandidateLabel = na
var table statusTable = table.new(position.top_right, 2, 5, border_width = 1)

bool confirmedHighThisBar = false
bool confirmedLowThisBar = false

if barstate.isconfirmed
    if not na(internalHigh)
        latestInternalHigh := internalHigh
        latestInternalHighBar := bar_index - internalBars
    if not na(internalLow)
        latestInternalLow := internalLow
        latestInternalLowBar := bar_index - internalBars

    if phase == 0
        if bootstrapMode == "Confirm high first"
            phase := 1
        else if bootstrapMode == "Confirm low first"
            phase := -1
        else if not na(latestInternalHighBar) and not na(latestInternalLowBar)
            // The latest completed turn identifies the active leg without an MA,
            // ATR threshold, ZigZag percentage or future-looking value.
            phase := latestInternalHighBar > latestInternalLowBar ? 1 : -1

        if phase == 1 and not na(latestInternalHigh)
            candidateHigh := latestInternalHigh
            candidateHighBar := latestInternalHighBar
            if not na(latestInternalLowBar) and latestInternalLowBar < candidateHighBar
                candidateHighIdm := latestInternalLow
                candidateHighIdmBar := latestInternalLowBar
        else if phase == -1 and not na(latestInternalLow)
            candidateLow := latestInternalLow
            candidateLowBar := latestInternalLowBar
            if not na(latestInternalHighBar) and latestInternalHighBar < candidateLowBar
                candidateLowIdm := latestInternalHigh
                candidateLowIdmBar := latestInternalHighBar

    if phase == 1
        bool extendsHigh = na(candidateHigh) or high > candidateHigh
        if extendsHigh
            candidateHigh := high
            candidateHighBar := bar_index
            if not na(latestInternalLowBar) and latestInternalLowBar < candidateHighBar
                candidateHighIdm := latestInternalLow
                candidateHighIdmBar := latestInternalLowBar

        bool hasHighSequence = not na(candidateHigh) and not na(candidateHighIdm) and candidateHighIdmBar < candidateHighBar and bar_index > candidateHighBar
        bool sweptHighIdm = breakMode == "Wick / sweep" ? low < candidateHighIdm : close < candidateHighIdm
        if hasHighSequence and sweptHighIdm
            string highTag = na(previousConfirmedHigh) ? "H" : candidateHigh > previousConfirmedHigh ? "HH" : candidateHigh < previousConfirmedHigh ? "LH" : "EH"
            label.new(candidateHighBar, candidateHigh, highTag, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = highColor, textcolor = color.white, size = size.small, tooltip = "Confirmed only at bar " + str.tostring(bar_index) + " after IDM was swept/broken.")
            if showIdm
                line.new(candidateHighIdmBar, candidateHighIdm, bar_index, candidateHighIdm, xloc = xloc.bar_index, color = idmColor, style = line.style_dashed)
                label.new(candidateHighIdmBar, candidateHighIdm, "IDM", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = color.new(idmColor, 72), textcolor = idmColor, size = size.tiny)
            if showConfirmation
                label.new(bar_index, low, "✓ H", xloc = xloc.bar_index, yloc = yloc.belowbar, style = label.style_label_up, color = color.new(highColor, 60), textcolor = color.white, size = size.tiny, tooltip = "High confirmed on this closed bar; the H/HH/LH label was not available earlier.")
            previousConfirmedHigh := candidateHigh
            confirmedHighThisBar := true
            phase := -1
            candidateLow := low
            candidateLowBar := bar_index
            candidateLowIdm := not na(latestInternalHighBar) and latestInternalHighBar < candidateLowBar ? latestInternalHigh : na
            candidateLowIdmBar := not na(latestInternalHighBar) and latestInternalHighBar < candidateLowBar ? latestInternalHighBar : na
            candidateHigh := na
            candidateHighBar := na
            candidateHighIdm := na
            candidateHighIdmBar := na

    else if phase == -1
        bool extendsLow = na(candidateLow) or low < candidateLow
        if extendsLow
            candidateLow := low
            candidateLowBar := bar_index
            if not na(latestInternalHighBar) and latestInternalHighBar < candidateLowBar
                candidateLowIdm := latestInternalHigh
                candidateLowIdmBar := latestInternalHighBar

        bool hasLowSequence = not na(candidateLow) and not na(candidateLowIdm) and candidateLowIdmBar < candidateLowBar and bar_index > candidateLowBar
        bool sweptLowIdm = breakMode == "Wick / sweep" ? high > candidateLowIdm : close > candidateLowIdm
        if hasLowSequence and sweptLowIdm
            string lowTag = na(previousConfirmedLow) ? "L" : candidateLow > previousConfirmedLow ? "HL" : candidateLow < previousConfirmedLow ? "LL" : "EL"
            label.new(candidateLowBar, candidateLow, lowTag, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = lowColor, textcolor = color.rgb(6, 24, 18), size = size.small, tooltip = "Confirmed only at bar " + str.tostring(bar_index) + " after IDM was swept/broken.")
            if showIdm
                line.new(candidateLowIdmBar, candidateLowIdm, bar_index, candidateLowIdm, xloc = xloc.bar_index, color = idmColor, style = line.style_dashed)
                label.new(candidateLowIdmBar, candidateLowIdm, "IDM", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(idmColor, 72), textcolor = idmColor, size = size.tiny)
            if showConfirmation
                label.new(bar_index, high, "✓ L", xloc = xloc.bar_index, yloc = yloc.abovebar, style = label.style_label_down, color = color.new(lowColor, 60), textcolor = color.white, size = size.tiny, tooltip = "Low confirmed on this closed bar; the L/HL/LL label was not available earlier.")
            previousConfirmedLow := candidateLow
            confirmedLowThisBar := true
            phase := 1
            candidateHigh := high
            candidateHighBar := bar_index
            candidateHighIdm := not na(latestInternalLowBar) and latestInternalLowBar < candidateHighBar ? latestInternalLow : na
            candidateHighIdmBar := not na(latestInternalLowBar) and latestInternalLowBar < candidateHighBar ? latestInternalLowBar : na
            candidateLow := na
            candidateLowBar := na
            candidateLowIdm := na
            candidateLowIdmBar := na

if barstate.islast
    if not na(liveCandidateLabel)
        label.delete(liveCandidateLabel)
        liveCandidateLabel := na
    if showCandidate
        if phase == 1 and not na(candidateHigh)
            liveCandidateLabel := label.new(candidateHighBar, candidateHigh, "H?", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = candidateColor, textcolor = color.white, size = size.tiny, tooltip = "Unconfirmed candidate. It can move until its IDM is swept/broken.")
        else if phase == -1 and not na(candidateLow)
            liveCandidateLabel := label.new(candidateLowBar, candidateLow, "L?", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = candidateColor, textcolor = color.white, size = size.tiny, tooltip = "Unconfirmed candidate. It can move until its IDM is swept/broken.")

    if showStatus
        table.cell(statusTable, 0, 0, "DD TH R0.1", text_color = color.white, bgcolor = color.rgb(26, 31, 36))
        table.cell(statusTable, 1, 0, "RESEARCH", text_color = idmColor, bgcolor = color.rgb(26, 31, 36))
        table.cell(statusTable, 0, 1, "Seeking", text_color = color.silver)
        table.cell(statusTable, 1, 1, phase == 1 ? "HIGH" : phase == -1 ? "LOW" : "BOOTSTRAP", text_color = phase == 1 ? highColor : lowColor)
        table.cell(statusTable, 0, 2, "IDM rule", text_color = color.silver)
        table.cell(statusTable, 1, 2, breakMode, text_color = color.white)
        table.cell(statusTable, 0, 3, "Internal L/R", text_color = color.silver)
        table.cell(statusTable, 1, 3, str.tostring(internalBars), text_color = color.white)
        table.cell(statusTable, 0, 4, "Signals", text_color = color.silver)
        table.cell(statusTable, 1, 4, "CLOSED BAR", text_color = lowColor)
    else
        table.clear(statusTable, 0, 0, 1, 4)

alertcondition(confirmedHighThisBar, "Trading Hub high confirmed", "A Trading Hub structure high was confirmed after its IDM was swept/broken on {{ticker}} {{interval}}.")
alertcondition(confirmedLowThisBar, "Trading Hub low confirmed", "A Trading Hub structure low was confirmed after its IDM was swept/broken on {{ticker}} {{interval}}.")

