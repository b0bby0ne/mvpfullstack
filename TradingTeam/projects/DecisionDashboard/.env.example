# Copy this file to .env.local and enter credentials on your machine.
# Never commit .env.local or paste the secret into chat.
CME_API_ID=
CME_API_SECRET=

# Start in certification. Change to production only after CME certification
# and the production market-data entitlement are active.
CME_ENV=certification
CME_PRODUCT_CODE=GC
CME_PRODUCT_TYPE=FUT
CME_MESSAGE_TYPES=TOB,TRD,STAT
# Optional contract filter, for example 202612. Empty subscribes to all GC futures.
CME_PERIOD_CODES=

# DataMine fallback for COMEX Gold end-of-day futures.
CME_DATAMINE_DATASET=EOD_XCEC_GC_FUT_0
