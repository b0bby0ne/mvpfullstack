OANDA_ACCOUNT_ID=your_oanda_account_id
OANDA_API_KEY=your_oanda_api_key
OANDA_HOST=api-fxpractice.oanda.com

# CCBSN Telegram Monitor Only
# Copy this file to TradingTeam/.env and replace placeholders locally.
# Never commit the real token, chat IDs, webhook secret or remote-access password.
CCBSN_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
CCBSN_TELEGRAM_ALLOWED_CHAT_IDS=your_authorized_chat_id
CCBSN_TELEGRAM_MODE=polling
CCBSN_TELEGRAM_WEBHOOK_SECRET=optional_webhook_secret
CCBSN_TERMINAL_DATA_PATH=C:\Users\your_user\AppData\Roaming\MetaQuotes\Terminal\your_terminal_id
CCBSN_STATUS_FILE=C:\Users\your_user\AppData\Roaming\MetaQuotes\Terminal\Common\Files\CCBSN\controller_status_v1.json
CCBSN_GATEWAY_STATE_FILE=TradingTeam\projects\ccbsn\runtime\telegram_monitor_state.json
CCBSN_MONITOR_POLL_SECONDS=5
CCBSN_HEARTBEAT_STALE_SECONDS=30
CCBSN_M15_DECISION_STALE_SECONDS=1200
